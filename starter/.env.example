# ============================================================================
# AI Assistant Container Project Configuration
# ============================================================================
# QUICK START:
# 1. Copy this file: cp .env.example .env
# 2. Set PROJECT_NAME to match your project directory name
# 3. Uncomment EITHER the CUI section OR the Non-CUI section below
# 4. Fill in required values
# 5. See docs/SETUP-CUI.md or docs/SETUP-NO-CUI.md for complete instructions
# ============================================================================

# ----------------------------------------------------------------------------
# Project Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Project name used for container naming in multi-project setups
# Recommendation: Set this to your project directory name (e.g., "my-project")
# This allows multiple projects to run containers simultaneously without conflicts
PROJECT_NAME=your-project-name-here

# ----------------------------------------------------------------------------
# CUI Projects (AWS Bedrock Configuration)
# ----------------------------------------------------------------------------
# For projects handling Controlled Unclassified Information (CUI)
# Requires: AWS Bedrock access, FedRAMP compliance, firewall protection
# See: docs/SETUP-CUI.md for complete setup instructions
#
# IMPORTANT: You also need .env.bedrock file with AWS credentials
# Generate it daily: aws configure export-credentials --profile claude-bedrock --format env-no-export > .env.bedrock

# Uncomment these lines for CUI projects:
#CLAUDE_CODE_USE_BEDROCK=1
#AWS_REGION=us-gov-east-1

# Static Model Configuration (admin-provided, do not modify without authorization)
# Using GovCloud inference profile IDs as required by Bedrock on-demand throughput
#ANTHROPIC_MODEL=us-gov.anthropic.claude-3-7-sonnet-20250219-v1:0
#ANTHROPIC_SMALL_FAST_MODEL=us-gov.anthropic.claude-3-haiku-20240307-v1:0

# Optional: Token limits
#CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
#MAX_THINKING_TOKENS=1024

# Optional: Disable prompt caching if needed
#DISABLE_PROMPT_CACHING=1

# ----------------------------------------------------------------------------
# Non-CUI Projects (Direct API Configuration)
# ----------------------------------------------------------------------------
# For projects NOT handling CUI data
# Uses: Anthropic API directly (simpler setup, works with Codespaces)
# See: docs/SETUP-NO-CUI.md for complete setup instructions

# Uncomment these lines for Non-CUI projects:
# File a #helpdesk ticket for API keys
#ANTHROPIC_API_KEY=

# Optional: Gemini API Key
#GEMINI_API_KEY=

# ============================================================================
# Notes:
# - Only uncomment ONE section above (CUI or Non-CUI), not both
# - CUI projects require .env.bedrock (AWS credentials) in addition to this file
# - Non-CUI projects only need this .env file
# - PROJECT_NAME is used by both CUI and Non-CUI for multi-project support
# ============================================================================
