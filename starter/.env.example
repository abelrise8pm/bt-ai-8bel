# ============================================================================
# AI Assistant Container Project Configuration
# ============================================================================
# QUICK START:
# 1. Copy this file: cp .env.example .env
# 2. Uncomment EITHER the CUI section OR the Non-CUI section below
# 3. Fill in required values
# 4. See docs/SETUP-CUI.md or docs/SETUP-NO-CUI.md for complete instructions
# ============================================================================

# ----------------------------------------------------------------------------
# CUI Projects (AWS Bedrock Configuration)
# ----------------------------------------------------------------------------
# For projects handling Controlled Unclassified Information (CUI)
# Requires: AWS Bedrock access, FedRAMP compliance, firewall protection
# See: docs/SETUP-CUI.md for complete setup instructions
#
# IMPORTANT: You also need .env.bedrock file with AWS credentials
# Generate it daily: aws configure export-credentials --profile bedrockaccess-yourproject --format env-no-export > .env.bedrock

# Uncomment these lines for CUI projects:
#CLAUDE_CODE_USE_BEDROCK=1
#AWS_REGION=us-gov-west-1
#ANTHROPIC_MODEL=us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0

# Required: Haiku is not available as an inference profile in GovCloud.
# Set the small/fast model to Sonnet so subagents (Explore tool) work.
# Both vars are set for compatibility across Claude Code versions.
#ANTHROPIC_SMALL_FAST_MODEL=us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0
#ANTHROPIC_DEFAULT_HAIKU_MODEL=us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0

# Workaround: Disable attribution header that Bedrock rejects as reserved keyword.
# See: https://github.com/anthropics/claude-code/issues/24168
#CLAUDE_CODE_ATTRIBUTION_HEADER=0

# Optional: Token limits (uncomment to override defaults    )
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096    # Max tokens per response (default: 4096-8192)
# MAX_THINKING_TOKENS=1024              # Extended thinking tokens (default: 10000)

# ----------------------------------------------------------------------------
# Non-CUI Projects (Direct API Configuration)
# ----------------------------------------------------------------------------
# For projects NOT handling CUI data
# Uses: Anthropic API directly (simpler setup)
# See: docs/SETUP-NO-CUI.md for complete setup instructions

# File a #helpdesk ticket for API keys
# NOTE: The onboarding script will automatically set this for you
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# GitHub CLI Token (Optional but Recommended)
# ----------------------------------------------------------------------------
# Used by Claude Code to read GitHub issues, PRs, repositories, and Actions status
# Create a token at: https://github.com/settings/tokens
# Required scopes:
#   - repo (for private repos) or public_repo (for public repos only)
#   - actions:read (to view GitHub Actions workflow runs and status)
#GH_TOKEN=

# ============================================================================
# Notes:
# - Only uncomment ONE section above (CUI or Non-CUI), not both
# - CUI projects require .env.bedrock (AWS credentials) in addition to this file
# - Non-CUI projects only need this .env file
# ============================================================================
