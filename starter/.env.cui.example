# AI Assistant Container Starter - CUI Projects Configuration Template
# Note: This configuration is REQUIRED for CUI projects
# This template configures Claude Code for projects WITH Controlled Unclassified Information
# Uses AWS Bedrock for FedRAMP compliance with sensitive data
# Copy this file to .env.claude
# See https://docs.anthropic.com/en/docs/claude-code/amazon-bedrock for details
#
# Two-file approach for CUI projects:
#   .env.bedrock  -> AWS credentials (created by: aws configure export-credentials --profile claude-bedrock --format env > .env.bedrock)
#   .env.claude   -> Claude Code configuration (this file)

# AWS Bedrock Configuration
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-gov-east-1

# Static Model Configuration (admin-provided, do not modify without authorization)
# Using GovCloud inference profile IDs as required by Bedrock on-demand throughput
ANTHROPIC_MODEL=us-gov.anthropic.claude-3-7-sonnet-20250219-v1:0
ANTHROPIC_SMALL_FAST_MODEL=us-gov.anthropic.claude-3-haiku-20240307-v1:0

# Optional: Token limits
CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
MAX_THINKING_TOKENS=1024

# Optional: Disable prompt caching if needed
# DISABLE_PROMPT_CACHING=1
