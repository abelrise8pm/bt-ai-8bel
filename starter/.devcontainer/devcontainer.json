{
  "image": "ghcr.io/rise8-us/xpai/ai-assistant-home@sha256:5c6cd1cb1fa0a6fae9abaa3cf21cb317e71ed505ed55d55c1fcfe5469ae397b2",
  "postCreateCommand": "echo 'Container ready with AI assistants pre-installed'",
