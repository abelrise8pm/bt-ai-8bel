{
  "dockerComposeFile": "docker-compose.firewall.yml",
  "service": "ai-assistant",
  "workspaceFolder": "/workspace",
  "remoteUser": "aiAssistant",
  "runServices": ["firewall-manager", "ai-assistant"],
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "settings": {
        "telemetry.telemetryLevel": "off",
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false,
        "extensions.ignoreRecommendations": true,
        "workbench.enableExperiments": false,
        "workbench.settings.enableNaturalLanguageSearch": false,
        "update.mode": "none",
        "update.showReleaseNotes": false,
        "git.autofetch": false,
        "git.autorefresh": false,
        "npm.fetchOnlinePackageInfo": false,
        "extensions.verifySignature": false,
        "http.proxySupport": "off",
        "settingsSync.enable": false,
        "workbench.cloudChanges.autoResume": "off",
        "workbench.cloudChanges.continueOn": "off",
        "chat.detectParticipant.enabled": false
      }

      // ======================================================================
      // PERFORMANCE OPTIMIZATION: File Watcher Exclusions (Optional)
      // ======================================================================
      // Prevents VS Code from watching large directories. Uncomment and merge
      // into the settings object above if you have large node_modules/build dirs.
      // ======================================================================
      // "settings": {
      //   "files.watcherExclude": {
      //     "**/node_modules/**": true,
      //     "**/.git/objects/**": true,
      //     "**/dist/**": true,
      //     "**/build/**": true,
      //     "**/__pycache__/**": true
      //   },
      //   "search.exclude": {
      //     "**/node_modules": true,
      //     "**/dist": true,
      //     "**/build": true
      //   }
      // }
    }
  }
}
