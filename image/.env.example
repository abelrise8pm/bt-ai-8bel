# For Claude Code
ANTHROPIC_API_KEY=

# This allows your assistant to use GitHub CLI commands
# Set up this token to have the permissions you want
# For safety sake, start with the minimum permissions (principle of least access)
# and increase as necessary.
# Steps for fine-grained token:

#   1. Go to GitHub Settings:
#     - Profile picture → Settings → Developer settings
#     - Click "Personal access tokens" → "Fine-grained tokens"
#     - Click "Generate new token"
#   2. Configure token:
#     - Token name: "GH CLI Actions Read-Only"
#     - Expiration: Choose duration
#     - Resource owner: Select your account/org
#     - Repository access: Choose specific repos or all repos
#   3. Set permissions:
#     - Actions: Read access only
#     - Metadata: Read access (usually required)
#     - Contents: Read access (if you need to read workflow files)
GH_TOKEN=
