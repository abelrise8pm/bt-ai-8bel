{
  "image": "ghcr.io/rise8-us/xpai-ai-assistant-container/project-container@sha256:bce49ca0943d998e3d5061143627f39d6261d243a687258c2b0124524337317a",
  "postCreateCommand": "echo 'Container ready for Non-CUI projects with AI assistants pre-installed'",
  "mounts": [
    "source=xpai-ai-assistant-container-claude-config,target=/home/aiAssistant/.claude,type=volume"
  ],
  "runArgs": [
    "--env-file",".env",
    "--cap-add=SYS_TIME"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "aiAssistant"
}