{
  "image": "ghcr.io/rise8-us/xpai-ai-assistant-container/project-container@sha256:4aa8a360c78fb2858b3fcb6e595f14c76e01c5f4baf5dbaae20be31f32b275d6",
  "postCreateCommand": "echo 'Container ready for Non-CUI projects with AI assistants pre-installed'",
  "mounts": [
    "source=xpai-ai-assistant-container-claude-config,target=/home/aiAssistant/.claude,type=volume"
  ],
  "runArgs": [
    "--env-file",".env",
    "--cap-add=SYS_TIME"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "aiAssistant"
}