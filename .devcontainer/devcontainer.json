{
  "image": "ghcr.io/rise8-us/xpai-ai-assistant-container/project-container@sha256:b56b552a26eb56f92d360bd04566cb84d606af42ce45986e6207abf1d5d673cd",
  "postCreateCommand": "echo 'Container ready for Non-CUI projects with AI assistants pre-installed'",
