{
  "image": "ghcr.io/rise8-us/xpai-ai-assistant-container/project-container@sha256:6d2bdf751c8d0b95b25bd8615df7d15f4e6045c061b01c80b8b2c3b1340393b9",
  "postCreateCommand": "echo 'Container ready for Non-CUI projects with AI assistants pre-installed'",
