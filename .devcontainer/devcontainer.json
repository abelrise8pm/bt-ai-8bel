{
  "image": "ghcr.io/rise8-us/xpai-ai-assistant-container/project-container@sha256:753d554b8f807db48db5dbd7d37af4dfcef6f27a0ea48e02d02d253e8f57cad4",
  "postCreateCommand": "echo 'Container ready for Non-CUI projects with AI assistants pre-installed'",
  "mounts": [
    "source=xpai-ai-assistant-container-claude-config,target=/home/aiAssistant/.claude,type=volume"
  ],
  "runArgs": [
    "--env-file",".env",
    "--cap-add=SYS_TIME"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "aiAssistant"
}