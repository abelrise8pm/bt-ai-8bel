# ============================================================================
# AI Assistant Container Project Configuration
# ============================================================================
# QUICK START:
# 1. Copy this file: cp .env.example .env
# 2. Set PROJECT_NAME to match your project directory name
# 3. Uncomment EITHER the CUI section OR the Non-CUI section below
# 4. Fill in required values
# 5. See docs/SETUP-CUI.md or docs/SETUP-NO-CUI.md for complete instructions
# ============================================================================

# ----------------------------------------------------------------------------
# Project Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Project name used for container naming in multi-project setups
# Recommendation: Set this to your project directory name (e.g., "my-project")
# This allows multiple projects to run containers simultaneously without conflicts
PROJECT_NAME=xp-ai-assistant-container

# File a #helpdesk ticket for API keys
ANTHROPIC_API_KEY=your-key-here

# Optional: Gemini API Key
#GEMINI_API_KEY=

# This allows your assistant to use GitHub CLI commands
# Set up this token to have the permissions you want
# For safety sake, start with the minimum permissions (principle of least access)
# and increase as necessary.
# Steps for fine-grained token:
#   1. Go to GitHub Settings:
#     - Profile picture → Settings → Developer settings
#     - Click "Personal access tokens" → "Fine-grained tokens"
#     - Click "Generate new token"
#   2. Configure token:
#     - Token name: "<gh_username> - <git_repo_name>"
#     - Resource owner: Select rise8-us
#     - Expiration: Default to 30 days
#     - Request message: "I am going to use this personal access token to give me AI assistant to <git_repo_name>."
#     - Repository access: Only select this repository.
#   3. Set permissions:
#     - Repository permissions:
#     - Actions: Read access only
#     - Metadata: Read access (usually required)
#     - Contents: Read access (if you need to read workflow files)
#     - (only as required) Issues: Read-only or Read and write
#     - Generate token and request access
#     - Open a #helpdesk ticket
GH_TOKEN=