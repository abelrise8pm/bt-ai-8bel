# ============================================================================
# AI Assistant Container Project Configuration
# ============================================================================
# QUICK START:
# 1. Copy this file: cp .env.example .env
# 2. Set PROJECT_NAME to match your project directory name
# 3. Uncomment EITHER the CUI section OR the Non-CUI section below
# 4. Fill in required values
# 5. See docs/SETUP-CUI.md or docs/SETUP-NO-CUI.md for complete instructions
# ============================================================================

# ----------------------------------------------------------------------------
# Project Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Project name used for container naming in multi-project setups
# Recommendation: Set this to your project directory name (e.g., "my-project")
# This allows multiple projects to run containers simultaneously without conflicts
PROJECT_NAME=xp-ai-assistant-container

# File a #helpdesk ticket for API keys
ANTHROPIC_API_KEY=your-key-here

# Optional: Gemini API Key
#GEMINI_API_KEY=

# Optional: GitHub Token for GitHub CLI (gh)
# Used by Claude Code to read GitHub issues, PRs, repositories, and Actions status
# Create a token at: https://github.com/settings/tokens
# Required scopes:
#   - repo (for private repos) or public_repo (for public repos only)
#   - actions:read (to view GitHub Actions workflow runs and status)
#GITHUB_TOKEN=
