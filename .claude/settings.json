{
  "permissions": {
     "allow": [
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(gh issue view:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(**/.env*)",
      "Edit(./.env*)",
      "Edit(**/.env*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(export)",
      "Bash(cat /proc/*/environ)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*credentials*)"
    ]
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); dir=$(echo \"$input\" | jq -r '.workspace.current_dir' | sed \"s|$HOME|~|\"); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then context_info=$(printf \" [Context: %.1f%% used]\" \"$used\"); else context_info=\"\"; fi; printf \"\\033[2m%s\\033[0m \\033[36m%s\\033[0m%s\" \"$model\" \"$dir\" \"$context_info\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/xpai-ai-assistant-container/.claude/hooks/enforce-branch.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/xpai-ai-assistant-container/.claude/hooks/notify-attention.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/xpai-ai-assistant-container/.claude/hooks/notify-stop.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/xpai-ai-assistant-container/.claude/hooks/notify-attention.sh"
          }
        ]
      }
    ]
  }
}
